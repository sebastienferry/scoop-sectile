#!/bin/sh
#
# Point bucket/sectile.json at a Sectile release.
#
# Usage: bin/update-manifest [vX.Y.Z]
#
# With no tag, the latest GitHub Release of sebastienferry/sectile. The
# checksum is read from that release's SHA256SUMS, never computed from a
# download, so the manifest vouches for exactly what the release vouches for.
# Prints the version the manifest now names; leaves the file untouched when it
# already names it. GITHUB_TOKEN, when set, authenticates the API call.
set -eu

repo=sebastienferry/sectile
archive=sectile-desktop-windows-amd64.zip
manifest=$(cd "$(dirname "$0")/.." && pwd)/bucket/sectile.json

tag=${1:-}
if [ -z "$tag" ]; then
  auth=
  if [ -n "${GITHUB_TOKEN:-}" ]; then auth="Authorization: Bearer ${GITHUB_TOKEN}"; fi
  tag=$(curl -fsSL ${auth:+-H "$auth"} "https://api.github.com/repos/${repo}/releases/latest" |
    sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p')
fi
case "$tag" in
  v[0-9]*.[0-9]*.[0-9]*) ;;
  *) echo "not a release tag: '${tag}'" >&2; exit 1 ;;
esac
version=${tag#v}

sums=$(curl -fsSL "https://github.com/${repo}/releases/download/${tag}/SHA256SUMS") ||
  { echo "${tag} publishes no SHA256SUMS" >&2; exit 1; }
hash=$(printf '%s\n' "$sums" | awk -v file="$archive" '$2 == file { print $1 }')
case "$hash" in
  *[!0-9a-f]* | "") echo "${tag} has no checksum for ${archive}" >&2; exit 1 ;;
esac
[ ${#hash} -eq 64 ] || { echo "${tag} has a malformed checksum for ${archive}" >&2; exit 1; }
url="https://github.com/${repo}/releases/download/${tag}/${archive}"

# Only the top-level version and the 64bit url and hash are rewritten: the
# autoupdate block keeps its $version placeholders.
tmp=${manifest}.tmp
trap 'rm -f "$tmp"' EXIT
sed -E \
  -e "s|^(    \"version\": \")[^\"]*(\")|\1${version}\2|" \
  -e "s|^(            \"url\": \")[^\"]*(\")|\1${url}\2|" \
  -e "s|^(            \"hash\": \")[0-9a-f]*(\")|\1${hash}\2|" \
  "$manifest" > "$tmp"

# Each line must have been found, or the manifest changed shape under this
# script and would be published half-updated.
grep -q "^    \"version\": \"${version}\"" "$tmp" &&
  grep -q "^            \"url\": \"${url}\"" "$tmp" &&
  grep -q "^            \"hash\": \"${hash}\"" "$tmp" ||
  { echo "bucket/sectile.json no longer has the lines this script rewrites" >&2; exit 1; }

if ! cmp -s "$tmp" "$manifest"; then cat "$tmp" > "$manifest"; fi
echo "$version"
